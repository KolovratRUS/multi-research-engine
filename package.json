{
  "name": "multi-research-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "smoke:mlb-live": "tsx scripts/smoke-mlb-live.ts",
    "smoke:backtest:mlb:live": "tsx scripts/smoke-mlb-backtest-live.ts",
    "backtest:mlb": "tsx scripts/backtest-mlb.ts",
    "inventory:mlb-fixtures": "tsx scripts/mlb-fixture-inventory.ts",
    "prospective:mlb:dry-run-check": "tsx scripts/mlb-prospective-dry-run-check.ts",
    "review:historical-export:full": "npm run backtest:mlb -- --review-export-json tests/backtesting/fixtures/historical-research-export/full-export-v1.json",
    "review:historical-export:batch": "npm run backtest:mlb -- --review-export-json tests/backtesting/fixtures/historical-research-export/full-export-v1.json --review-export-json tests/backtesting/fixtures/historical-research-export/team-only-export-v1.json",
    "review:historical-export:ci": "npm run backtest:mlb -- --review-export-json tests/backtesting/fixtures/historical-research-export/full-export-v1.json --review-export-json tests/backtesting/fixtures/historical-research-export/team-only-export-v1.json --review-thresholds-json tests/backtesting/fixtures/historical-research-threshold-presets/passing-ci-thresholds-v1.json",
    "review:historical-export:ci:json": "npm run backtest:mlb -- --output json --review-export-json tests/backtesting/fixtures/historical-research-export/full-export-v1.json --review-export-json tests/backtesting/fixtures/historical-research-export/team-only-export-v1.json --review-thresholds-json tests/backtesting/fixtures/historical-research-threshold-presets/passing-ci-thresholds-v1.json",
    "review:historical-export:release-check": "npm run review:historical-export:full && npm run review:historical-export:batch && npm run review:historical-export:ci && npm run review:historical-export:ci:json",
    "review:historical-export:rollout": "npm run review:historical-export:release-check && npx vitest run tests/backtesting/cli-review-threshold-presets.test.ts tests/backtesting/cli-review-export-batch.test.ts tests/backtesting/cli-review-export.test.ts tests/backtesting/historical-research-export.test.ts tests/backtesting/historical-research-export-validation.test.ts tests/backtesting/cli-export-golden.test.ts --reporter=verbose && npx vitest run tests/backtesting --reporter=verbose && npx tsc --noEmit --incremental false --pretty false && npm test && npm run build && git diff --check"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
